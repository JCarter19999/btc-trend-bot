# Coinbase CDP key name and private key. Never commit the populated file.
COINBASE_API_KEY=organizations/ORG_ID/apiKeys/KEY_ID
COINBASE_API_SECRET=YOUR_PRIVATE_KEY_OR_BASE64_SECRET

# Required only when deployment.mode is live.
LIVE_TRADING_ACK=I_UNDERSTAND_THIS_PLACES_REAL_ORDERS

# Optional Discord/Slack-compatible incoming webhook.
BTC_BOT_WEBHOOK_URL=

# Binance credentials are optional and must remain unset for historical/local paper work.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
