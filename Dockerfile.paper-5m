FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir . "pytest>=8,<9"

COPY config ./config
COPY tests ./tests

RUN mkdir -p /app/runtime /app/outputs

CMD ["python", "-m", "btc_trend_bot.paper_lab", \
     "--config", "config/settings_paper_5m.yaml", "step"]
