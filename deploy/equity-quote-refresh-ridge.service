[Unit]
Description=Equity intraday quote refresh, Ridge control arm (current_price only, no trading decisions)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=joey
Group=joey
WorkingDirectory=/home/joey/equity_v2_4
EnvironmentFile=-/home/joey/.config/btc-trend-bot/telemetry.env
ExecStart=/home/joey/equity_v2_4/.venv/bin/python experiments/run_equity_paper_step.py --config config/settings_equity_paper_yfinance.yaml refresh-quote
TimeoutStartSec=60
Nice=10
