[Unit]
Description=Equity daily paper-trading step, exit-regime/simple_trend strategy (yfinance live-data stand-in, no live orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=joey
Group=joey
WorkingDirectory=/home/joey/equity_v2_4
EnvironmentFile=-/home/joey/.config/btc-trend-bot/telemetry.env
ExecStart=/home/joey/equity_v2_4/.venv/bin/python experiments/run_equity_paper_step.py --config config/settings_equity_paper_yfinance_simpletrend.yaml step
TimeoutStartSec=120
Nice=10
